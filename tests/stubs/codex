#!/usr/bin/env bash
# Stub `codex` for tests/run.sh. Records its argv, then behaves per STUB_CODEX:
#   fix (default) · violation · nothing · quota · badmodel · sleep · crash (echoes the prompt, then fails)
# For fix/violation it writes every path on the spec's "Files:" line, relative
# to --cd — exactly where the real CLI would write.
set -u
[ "${1:-}" = exec ] || { echo "stub codex: only 'exec' is supported" >&2; exit 2; }
cd_dir="" out=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[i]}" in
    --cd) cd_dir="${args[i+1]}" ;;
    --output-last-message) out="${args[i+1]}" ;;
  esac
done
[ -n "${STUB_ARGV_DIR:-}" ] && printf '%s\n' "$@" > "$STUB_ARGV_DIR/argv.$$"
spec=$(cat)
echo "stub codex transcript line (stderr)" >&2
case "${STUB_CODEX:-fix}" in
  quota)    echo "ERROR: You've hit your usage limit. Try again at 3:05 PM." >&2; exit 1 ;;
  badmodel) echo "ERROR: The model 'gpt-9' does not exist or you do not have access to it." >&2; exit 1 ;;
  sleep)    sleep 30; exit 0 ;;
  crash)    printf '%s\n' "$spec" >&2; echo "ERROR: internal panic in tool runner" >&2; exit 1 ;;
  nothing)  echo "done" > "$out"; exit 0 ;;
esac
[ -n "${STUB_DELAY:-}" ] && sleep "$STUB_DELAY"
files=$(printf '%s\n' "$spec" | sed -n 's/^Files: *//p' | tr ',' '\n')
for f in $files; do
  mkdir -p "$cd_dir/$(dirname "$f")"
  printf 'def add(a, b):\n    return a + b\n' > "$cd_dir/$f"
done
[ "${STUB_CODEX:-fix}" = violation ] && echo "stray" > "$cd_dir/docs/README.md"
echo "stub codex: implemented ${files//$'\n'/ }" > "$out"
exit 0
