#!/usr/bin/env python3
"""Offline stand-in for an Imajev server: POST /v1/systemone, Jev-shaped answers.

    imajevstub PORTFILE     # binds 127.0.0.1 on a free port and writes it to PORTFILE

Each request re-reads STUB_IMAJEV_CTL (a JSON object; missing = defaults), so
one server serves every test case:
  mode     ok (default) | malformed | noanswer | noconf | notjson_object | http500 | http422
  choice   the answer (default luna_low); conf (0.91); unknown (0.01); abstained (false)
  delay    seconds to wait before answering
Every request appends to STUB_IMAJEV_MARK and saves its body to STUB_IMAJEV_LOG.
"""
import json, os, sys, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


def control():
    try:
        with open(os.environ.get("STUB_IMAJEV_CTL", "")) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {}


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def reply(self, status, body):
        data = body if isinstance(body, bytes) else json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        try:
            self.wfile.write(data)
        except (BrokenPipeError, ConnectionResetError):
            pass  # the client already gave up (the timeout tests)

    def do_POST(self):
        body = self.rfile.read(int(self.headers.get("Content-Length", "0")))
        if os.environ.get("STUB_IMAJEV_MARK"):
            with open(os.environ["STUB_IMAJEV_MARK"], "a") as handle:
                handle.write(self.path + "\n")
        if os.environ.get("STUB_IMAJEV_LOG"):
            with open(os.environ["STUB_IMAJEV_LOG"], "wb") as handle:
                handle.write(body)
        ctl = control()
        time.sleep(float(ctl.get("delay", 0)))
        mode = ctl.get("mode", "ok")
        if self.path != "/v1/systemone":
            return self.reply(404, {"error": "http_error", "detail": "Not Found"})
        if mode == "http500":
            return self.reply(500, {"error": "RuntimeError", "detail": "stub failure"})
        if mode == "http422":
            return self.reply(422, {"error": "invalid_request", "detail": "stub refusal"})
        if mode == "malformed":
            return self.reply(200, b"this is not json")
        if mode == "notjson_object":
            return self.reply(200, [1, 2, 3])
        request = json.loads(body)
        criteria = request["questions"]["answer"]["criteria"]
        choice = ctl.get("choice", "luna_low")
        rest = [k for k in criteria if k != choice]
        top = float(ctl.get("top", 0.9))
        probabilities = {k: round((1 - top) / max(1, len(rest)), 4) for k in rest}
        probabilities[choice] = top
        probabilities["zz_offlist"] = 0.0   # a real server never sends this; the adapter must drop it
        answer = {"type": "choice", "choice": choice, "probabilities": probabilities,
                  "confidence": float(ctl.get("conf", 0.91)),
                  "unknown_probability": float(ctl.get("unknown", 0.01)),
                  "abstained": bool(ctl.get("abstained", False)),
                  "calibration_version": "stub-cal"}
        if mode == "noconf":
            del answer["confidence"]
        document = {"model": "imajev-4b", "answers": {"answer": answer},
                    "usage": {"total_ms": 12.3, "input_tokens": 99}}
        if mode == "noanswer":
            document["answers"] = {}
        self.reply(200, document)


server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
server.daemon_threads = True
with open(sys.argv[1] + ".tmp", "w") as handle:
    handle.write(str(server.server_address[1]))
os.replace(sys.argv[1] + ".tmp", sys.argv[1])
server.serve_forever()
